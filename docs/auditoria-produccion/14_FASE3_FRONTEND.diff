new file mode 100644
--- /dev/null
+++ b/scripts/build-checkout-offline.mjs
@@ -0,0 +1,11 @@
+// Same TypeScript project build and Vite pipeline, without loading any .env file.
+import { execFileSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { resolve } from 'node:path';
+import { build } from 'vite';
+const root = fileURLToPath(new URL('../', import.meta.url));
+for (const name of Object.keys(process.env)) if (name.startsWith('VITE_')) delete process.env[name];
+process.env.VITE_API_BASE_URL = 'http://127.0.0.1:8000';
+process.env.VITE_PAYPAL_CLIENT_ID = 'synthetic-client-not-commercial';
+execFileSync(process.execPath, [resolve(root, 'node_modules/typescript/bin/tsc'), '-b'], { cwd: root, stdio: 'inherit' });
+await build({ root, envDir: false, mode: 'checkout-offline', build: { outDir: 'node_modules/.cache/checkout-offline-dist' } });
diff --git a/src/components/CheckoutPayPal.tsx b/src/components/CheckoutPayPal.tsx
new file mode 100644
--- /dev/null
+++ b/src/components/CheckoutPayPal.tsx
@@ -0,0 +1,18 @@
+import { PayPalButtons, PayPalScriptProvider } from '@paypal/react-paypal-js';
+import { checkoutCallbacks } from '../services/CheckoutCallbacks';
+import { CheckoutError } from '../services/Checkout.service';
+import type { CheckoutQuote } from '../services/Checkout.service';
+import type { CheckoutSession } from '../services/CheckoutSession';
+
+export default function CheckoutPayPal({ session, prepareQuote, disabled, clientId }: {
+  session: CheckoutSession; prepareQuote: () => Promise<CheckoutQuote>; disabled: boolean; clientId: string;
+}) {
+  if (!clientId) return <p role="status">El pago está temporalmente no disponible.</p>;
+  const callbacks = checkoutCallbacks(session, async () => {
+    if (disabled && !session.snapshot().reference) throw new CheckoutError('CHECKOUT_BLOCKED');
+    return prepareQuote();
+  });
+  return <PayPalScriptProvider options={{ clientId, currency: 'MXN', intent: 'capture' }}>
+    <PayPalButtons disabled={disabled} style={{ layout: 'vertical', color: 'gold', label: 'pay' }} {...callbacks} />
+  </PayPalScriptProvider>;
+}
diff --git a/src/components/CheckoutStatus.tsx b/src/components/CheckoutStatus.tsx
new file mode 100644
--- /dev/null
+++ b/src/components/CheckoutStatus.tsx
@@ -0,0 +1,18 @@
+import { displayMoney } from '../services/Checkout.service';
+import type { CheckoutState } from '../services/CheckoutSession';
+
+const labels = { idle: 'Selecciona una tarifa para continuar.', creating_intent: 'Preparando tu compra…',
+  creating_paypal: 'Preparando la aprobación en PayPal…', awaiting_approval: 'Esperando tu aprobación en PayPal.',
+  capturing: 'Confirmando el pago…', pending: 'Tu compra está pendiente de confirmación. No inicies otra compra.',
+  reconciling: 'Consultando el resultado de tu compra…', paid: 'Pago confirmado', cancelled: 'Compra cancelada antes del cobro.',
+  attention: 'Tu compra requiere atención.', unavailable: 'Las compras están temporalmente no disponibles.',
+  requote: 'La cotización cambió o venció. Debes cotizar de nuevo.' };
+export default function CheckoutStatus({ state }: { state: CheckoutState }) {
+  const confirmed = state.phase === 'paid' && state.intent?.state === 'CAPTURED' && state.intent.order_id;
+  return <section role="status" aria-live="polite">
+    <h2>{confirmed ? `Pago confirmado. Pedido #${state.intent!.order_id}` : state.phase === 'paid' ? 'Tu compra requiere atención.' : labels[state.phase]}</h2>
+    {state.message && <p>{state.message}</p>}
+    {state.intent && <p>Importe registrado: {displayMoney(state.intent.total)}</p>}
+    {state.intent?.fulfillment_state === 'REQUIRES_MANUAL_RECONCILIATION' && <p>El pago está registrado. La preparación del pedido requiere revisión por nuestro equipo.</p>}
+  </section>;
+}
